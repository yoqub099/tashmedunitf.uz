# EditorConfig — https://editorconfig.org
# Consistent coding style across editors and IDEs

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{php,py}]
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[{package.json,*.code-workspace}]
indent_size = 2
