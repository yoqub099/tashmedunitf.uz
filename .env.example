# ============================================================
# TMTU Termiz — Root Environment Template
# ============================================================
# Copy this to `.env` and fill in real values.
# NEVER commit `.env` to git (already in .gitignore).
# Use a secrets manager (Doppler/Vault/AWS Secrets Manager) in production.
# ============================================================

# ----- Application -----
APP_NAME="TMTU Termiz"
NODE_ENV=development

# ----- Backend API (Laravel) -----
API_PORT=8000
API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api

# ----- Public Website (Next.js) -----
WEB_PORT=3000
WEB_URL=http://localhost:3000

# ----- Admin Panel (Next.js) -----
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001

# ----- Database (PostgreSQL 16) -----
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=tmtu_termiz
DB_USERNAME=postgres
DB_PASSWORD=__CHANGE_ME__

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# ----- ISR Revalidation Webhook -----
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=__GENERATE_RANDOM_32_HEX__

# ----- Sanctum (Backend Auth) -----
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

# ----- Mail (SMTP) -----
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=__CHANGE_ME__
MAIL_PASSWORD=__CHANGE_ME__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@tashmedunitf.uz
MAIL_FROM_NAME="${APP_NAME}"

# ----- Analytics (Optional) -----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ----- SEO Verification (Optional) -----
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ----- Sentry Error Tracking (Optional) -----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
