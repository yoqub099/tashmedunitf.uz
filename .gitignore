# ============================================================
# TMTU Termiz Monorepo — .gitignore
# ============================================================

# ----- Dependencies -----
node_modules/
vendor/
.pnpm-store/
jspm_packages/

# ----- Build outputs -----
.next/
.turbo/
.nx/
dist/
build/
out/
storybook-static/
*.tsbuildinfo
next-env.d.ts

# ----- Environment files (SECURITY!) -----
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
!.env.example
!.env.test

# ----- IDE -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.swp
*.swo
*~
.fleet/

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Testing -----
coverage/
.nyc_output/
playwright-report/
test-results/
.auth/
*.lcov

# E2E artifacts (Playwright + Axe)
e2e/screenshots/
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# ----- Caches -----
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache

# ----- Backend (Laravel) -----
apps/api/storage/logs/*
!apps/api/storage/logs/.gitkeep
apps/api/storage/framework/cache/*
!apps/api/storage/framework/cache/.gitkeep
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitkeep
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitkeep
apps/api/storage/app/private/*
!apps/api/storage/app/private/.gitkeep
apps/api/storage/app/backup/*
!apps/api/storage/app/backup/.gitkeep
apps/api/bootstrap/cache/*.php
!apps/api/bootstrap/cache/.gitkeep
apps/api/public/storage
apps/api/public/hot

# ----- Database backups (SECURITY: PII!) -----
*.sql
*.sql.gz
*.dump
database_backup_*
backup_*.sql

# ----- Secrets & credentials -----
.token
*.token
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
.envrc

# ----- Temporary files -----
tmp/
temp/
*.tmp
*.bak
*.orig
*~

# ----- Test/debug artifacts -----
apps/api/connectivity_results.txt
apps/api/crud_test_results.txt
apps/api/crud-test-results.txt
apps/api/full_crud_results.txt
apps/api/image_crud_results.txt

# ----- Docker -----
docker-compose.override.yml
.docker-data/

# ----- Generated -----
apps/web/public/sw.js
apps/web/public/workbox-*.js
apps/admin/public/sw.js

# ----- Sentry -----
.sentryclirc

# ----- Local development -----
.local/
*.local

# ----- Session / agent artifacts (not part of the project) -----
.playwright-mcp/
/image.png
/tmtu-homepage-deployed.jpeg
