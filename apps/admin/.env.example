# ============================================================
# ADMIN PANEL .env
# Copy to .env.local for local dev
# ============================================================

# Laravel API v1 endpoint (WITH /v1 suffix, NO trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public frontend URL (for preview links, ISR revalidation)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ISR revalidation secret — MUST match backend + frontend REVALIDATION_SECRET
REVALIDATION_SECRET=change-me-to-random-32-char-string

# ────────────────────────────────────────────────────────────
# PRODUCTION (example)
# ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.tashmedunitf.uz/api/v1
# NEXT_PUBLIC_FRONTEND_URL=https://tashmedunitf.uz
# REVALIDATION_SECRET=<generate via: openssl rand -hex 32>
