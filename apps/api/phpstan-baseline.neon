parameters:
	ignoreErrors:
		-
			message: '#^Invalid array key type float\.$#'
			identifier: offsetAccess.invalidOffset
			count: 1
			path: app/Console/Commands/CleanOrphanMedia.php

		-
			message: '#^Parameter \#1 \$bytes of method App\\Console\\Commands\\MediaHealth\:\:humanSize\(\) expects int, float given\.$#'
