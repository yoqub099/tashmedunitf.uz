# ============================================================
# FRONTEND .env (public site)
# Copy to .env.local for local dev
# ============================================================

# Laravel API endpoint (NO trailing slash, NO /v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ISR revalidation secret — MUST match backend REVALIDATION_SECRET and admin
REVALIDATION_SECRET=change-me-to-random-32-char-string

# ────────────────────────────────────────────────────────────
# PRODUCTION (example)
# ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.tashmedunitf.uz/api
# REVALIDATION_SECRET=<generate via: openssl rand -hex 32>

# ────────────────────────────────────────────────────────────
# Analytics (loaded only after user accepts cookies)
# ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_YANDEX_METRIKA_ID=99999999

# ────────────────────────────────────────────────────────────
# Search engine verification (meta tags)
# Google Search Console: https://search.google.com/search-console
# Yandex Webmaster:      https://webmaster.yandex.com
# Bing Webmaster Tools:  https://www.bing.com/webmasters
# ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_VERIFICATION=<code from Search Console>
# NEXT_PUBLIC_YANDEX_VERIFICATION=<code from Yandex Webmaster>
# NEXT_PUBLIC_BING_VERIFICATION=<code from Bing Webmaster>

# ────────────────────────────────────────────────────────────
# Contact info overrides (optional)
# ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CONTACT_PHONE=+998 76 221-40-30
# NEXT_PUBLIC_CONTACT_EMAIL=info@tashmedunitf.uz
